# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Vite cache
.vite/

# Environment files — never commit secrets (e.g. a contact-form endpoint
# or API key). Commit .env.example instead to document required keys.
.env
.env.*
!.env.example

# Vite's local-override convention
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
