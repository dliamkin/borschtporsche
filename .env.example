# In order to get the contact form working, do this manual step:
# Copy this file to .env and fill in the values. .env is gitignored.
#
# Web3Forms access key for the contact form (https://web3forms.com).
# Vite inlines VITE_* variables at build time, so this value ships in the
# client bundle - that is expected: the key only allows posting to our
# Web3Forms inbox, it does not expose any submitted data.
#
# Production: set this in Cloudflare Pages -> project -> Settings ->
# Environment variables (along with NODE_VERSION=20) so production builds
# pick it up. The build throws if it is missing (see src/lib/contact.js).
VITE_WEB3FORMS_KEY=web3forms-access-key
