# In order to get the contact form working, do this manual step:
# Copy this file to .env and fill in the values. .env is gitignored.
#
# Web3Forms access key for the contact form (https://web3forms.com).
# Vite inlines VITE_* variables at build time, so this value ships in the
# client bundle - that is expected: the key only allows posting to our
# Web3Forms inbox, it does not expose any submitted data.
#
# Production: this deploys as a Worker (see wrangler.jsonc), so set it under
# Settings -> Build -> "Build variables and secrets" (along with
# NODE_VERSION=20). NOT under Settings -> Variables & Secrets: those are
# runtime bindings for a Worker script, and Vite needs the value at BUILD
# time. Build-setting changes only apply to the NEXT build, so push a commit
# rather than retrying the failed deployment.
# The form throws at submit time if this is missing (see src/lib/contact.js).
VITE_WEB3FORMS_KEY=web3forms-access-key
