{
    // Cloudflare Workers config: serve the Vite build output as static assets.
    // Deploy command on Cloudflare: `npx wrangler deploy` (runs after `npm run build`).
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "borschtporsche",
    "compatibility_date": "2026-08-27",
    "assets": {
        "directory": "./dist",
        // Serve index.html for unknown paths so react-router handles deep links.
        "not_found_handling": "single-page-application"
    }
}
